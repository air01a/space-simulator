[param]
name=Apollo
dockable=True

[stage1]
S-IC=13020, 2800, 130000, 2278870,45

[stage2]
S-II=1250,4300,36500,445000,0

[stage3]
S-IVB=250,4300,11300,107000,0

[stage4]
# CSM: Service Module (engine, fuel) + Command Module (crew capsule)
SM=32,2800,3000,21500,15
CM=0,0,5500,0,15

[stage5]
LEM_Descent=32,2800,2000,10000,0

[stage6]
LEM_Ascent=10,2800,2000,2500,0

# Shapes for the 2D drawing of the rocket (meters)
[shape.s-ic]
length = 42
diameter = 10
top = none
nozzles = 5
color = #f2f2f2
band = #1e1e1e
position = center

[shape.s-ii]
length = 24.9
diameter = 10
top = none
nozzles = 5
color = #f2f2f2
position = center

[shape.s-ivb]
length = 17.8
diameter = 6.6
top = none
nozzles = 1
color = #f2f2f2
band = #1e1e1e
position = center

[shape.sm]
length = 7.5
diameter = 3.9
top = none
nozzles = 1
color = #b4b4b4
position = center

# Capsule + launch escape tower (the tower is drawn on the launcher only)
[shape.cm]
length = 13.1
diameter = 3.9
top = capsule_les
nozzles = 0
color = #d8d8d8
position = center

# Heat shield: survives the atmospheric reentry
# parachute = canopy diameter (m), count, deploy altitude (m), max deploy speed (m/s)
[equipment.cm]
heat_shield = yes
parachute = 25.4, 3, 3000, 200

[shape.lem_descent]
length = 3.2
diameter = 4.2
top = none
nozzles = 1
color = #c9a227
position = center
draw_below = sm
enclosed = true

[shape.lem_ascent]
length = 2.8
diameter = 4.0
top = none
nozzles = 1
color = #8c8c8c
position = center
draw_below = sm
enclosed = true
